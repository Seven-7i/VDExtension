{
  "name": "vdextension",
  "version": "0.1.0",
  "private": true,
  "description": "Video Download Extension - Download videos from any webpage",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-ffmpeg.js && tsc && vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "chrome-extension",
    "video-download",
    "ffmpeg",
    "wasm"
  ],
  "author": "Seven-7i",
  "license": "MIT",
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
